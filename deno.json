{
  "tasks": {
    "check": "deno fmt --check && deno lint",
    "test": "deno test -A",
    "fix": "deno fmt && deno lint --fix"
  },
  "fmt": {
    "indentWidth": 2,
    "singleQuote": false,
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["dom", "dom.iterable", "deno.ns", "es2023"]
  }
}
